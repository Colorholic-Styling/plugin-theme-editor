<section class="features">
  {% render '/snippets/section-head', settings: section.settings %}
  {% for row in section.blocks %}
  {% assign feature = row.settings | default: row %}
  <article>
    <h3>{{ feature.name | escape }}</h3>
    <p>{{ feature.description | escape }}</p>
  </article>
  {% endfor %}
</section>
