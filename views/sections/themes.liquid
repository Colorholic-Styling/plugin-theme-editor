<div class="px-4 py-5 sm:px-6 sm:py-8 lg:px-8">
  <div class="mb-4 flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">{{ title }}</h1>
      <p class="mt-1 text-sm text-gray-500">{{ description }}</p>
    </div>
  </div>

  {% if flash != blank %}
    <p class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{{ flash }}</p>
  {% endif %}

  {% if canEdit %}
    <section class="mb-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold text-gray-900">GitHub themes</h2>
          {% if githubConnected %}
            <p class="mt-1 text-sm text-gray-500">
              Connected to {{ githubAccount }}. Choose one of the repositories granted to the GitHub App.
            </p>
          {% else %}
            <p class="mt-1 text-sm text-gray-500">
              Connect GitHub, choose the repositories this editor may use, then add a theme.
            </p>
          {% endif %}
        </div>

        {% if githubAppConfigured %}
          {% if githubConnected %}
            <div class="flex flex-wrap gap-2">
              <a href="{{ githubManageHref }}" target="_blank" rel="noopener noreferrer"
                 class="inline-flex h-10 items-center justify-center rounded-lg border border-gray-300 bg-white px-4 text-sm font-semibold text-gray-700 hover:bg-gray-50">
                Manage repositories
              </a>
              <form method="post" action="{{ githubDisconnectAction }}"
                    data-confirm="Disconnect GitHub from this CMS? Existing themes remain in the theme bucket.">
                <button type="submit"
                        class="inline-flex h-10 items-center justify-center rounded-lg border border-gray-300 bg-white px-4 text-sm font-semibold text-gray-700 hover:bg-gray-50">
                  Disconnect
                </button>
              </form>
            </div>
          {% else %}
            <form method="post" action="{{ githubConnectAction }}">
              <button type="submit"
                      class="inline-flex h-10 items-center justify-center rounded-lg bg-gray-900 px-4 text-sm font-semibold text-white hover:bg-black">
                Connect GitHub
              </button>
            </form>
          {% endif %}
        {% endif %}
      </div>

      {% if githubError != blank %}
        <p class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-700">{{ githubError }}</p>
      {% endif %}
      {% if githubAppConfigurationMessage != blank %}
        <p class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-700">
          {{ githubAppConfigurationMessage }}
        </p>
      {% endif %}

      {% if githubConnected %}
        {% if githubRepositories.size > 0 %}
          <form method="post" action="{{ cloneAction }}" class="mt-4 flex flex-wrap items-end gap-3">
            <label class="min-w-0 flex-1" style="min-width:18rem">
              <span class="mb-1 block text-sm font-medium text-gray-700">Repository</span>
              <select name="repository" required
                      class="block h-10 w-full rounded-lg border border-gray-300 bg-white px-3 text-sm">
                {% for repository in githubRepositories %}
                  <option value="{{ repository.fullName }}">
                    {{ repository.fullName }}{% if repository.private %} · Private{% endif %}
                  </option>
                {% endfor %}
              </select>
            </label>
            <label style="min-width:9rem">
              <span class="mb-1 block text-sm font-medium text-gray-700">Branch</span>
              <input name="branch" placeholder="default branch"
                     class="block h-10 w-full rounded-lg border border-gray-300 px-3 text-sm">
            </label>
            <label style="min-width:9rem">
              <span class="mb-1 block text-sm font-medium text-gray-700">Directory</span>
              <input name="path" placeholder="blank for root"
                     class="block h-10 w-full rounded-lg border border-gray-300 px-3 text-sm">
            </label>
            <label style="min-width:10rem">
              <span class="mb-1 block text-sm font-medium text-gray-700">Theme id</span>
              <input name="theme_id" placeholder="from repository"
                     class="block h-10 w-full rounded-lg border border-gray-300 px-3 text-sm">
            </label>
            <button type="submit"
                    class="inline-flex h-10 items-center justify-center rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700">
              Add theme
            </button>
          </form>
        {% else %}
          <p class="mt-4 text-sm text-gray-500">
            No repositories are available. Use Manage repositories to grant this App access to a repository.
          </p>
        {% endif %}
      {% elsif githubAppConfigured %}
        <p class="mt-4 text-sm text-gray-500">
          GitHub will handle sign-in and repository approval. This CMS stores only the resulting installation id.
        </p>
      {% else %}
        <form method="post" action="{{ cloneAction }}" class="mt-4 flex flex-wrap items-end gap-3">
          <label class="min-w-0 flex-1" style="min-width:18rem">
            <span class="mb-1 block text-sm font-medium text-gray-700">Repository</span>
            <input name="url" placeholder="https://github.com/owner/repo"
                   class="block h-10 w-full rounded-lg border border-gray-300 px-3 text-sm">
          </label>
          <label style="min-width:8rem">
            <span class="mb-1 block text-sm font-medium text-gray-700">Branch</span>
            <input name="branch" value="main"
                   class="block h-10 w-full rounded-lg border border-gray-300 px-3 text-sm">
          </label>
          <label style="min-width:9rem">
            <span class="mb-1 block text-sm font-medium text-gray-700">Directory</span>
            <input name="path" placeholder="blank for root"
                   class="block h-10 w-full rounded-lg border border-gray-300 px-3 text-sm">
          </label>
          <label style="min-width:10rem">
            <span class="mb-1 block text-sm font-medium text-gray-700">Theme id</span>
            <input name="theme_id" placeholder="from repository"
                   class="block h-10 w-full rounded-lg border border-gray-300 px-3 text-sm">
          </label>
          <button type="submit"
                  class="inline-flex h-10 items-center justify-center rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700">
            Clone
          </button>
        </form>
        {% unless hasGitHubToken %}
          <p class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-700">
            Configure the GitHub App, or set <code>GITHUB_TOKEN</code> as a Worker secret for the manual fallback.
          </p>
        {% endunless %}
      {% endif %}
    </section>
  {% endif %}

  <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
    <table class="w-full min-w-[560px] text-left">
      <thead class="border-b border-gray-200 bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-500">Theme</th>
          <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-500">Source</th>
          <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-500">Status</th>
          <th class="px-6 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {% for theme in themes %}
          <tr>
            <td class="px-6 py-4">
              <a href="{{ theme.editorHref }}"
                 class="font-semibold text-indigo-600 hover:text-indigo-800">{{ theme.name }}</a>
              <p class="mt-1 text-sm text-gray-500">{{ theme.description }}</p>
            </td>
            <td class="px-6 py-4 text-sm text-gray-600">{{ theme.source }}</td>
            <td class="px-6 py-4">
              <span class="inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700">{{ theme.status }}</span>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2">
                {% if theme.canPush and canEdit %}
                  <form method="post" action="{{ pushAction }}" class="shrink-0"
                        data-confirm="Commit this theme's templates to {{ theme.source }}?">
                    <input type="hidden" name="theme" value="{{ theme.id }}">
                    <button type="submit"
                            title="Commit and push {{ theme.name }} to {{ theme.source }}"
                            class="inline-flex h-10 items-center justify-center rounded-lg border border-gray-300 bg-white px-4 text-sm font-semibold text-gray-700 hover:bg-gray-50">
                      Push to GitHub
                    </button>
                  </form>
                {% endif %}
                <a href="{{ theme.editorHref }}"
                   title="Edit {{ theme.name }}"
                   aria-label="Edit {{ theme.name }}"
                   class="inline-flex h-10 items-center justify-center rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700">
                  Edit theme
                </a>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="4" class="px-6 py-10 text-center text-sm text-gray-400">No themes are available.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
