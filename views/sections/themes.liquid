<div class="px-4 py-5 sm:px-6 sm:py-8 lg:px-8">
  <div class="mb-4 flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">{{ title }}</h1>
      <p class="mt-1 text-sm text-gray-500">{{ description }}</p>
    </div>
  </div>

  <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
    <table class="w-full min-w-[560px] text-left">
      <thead class="border-b border-gray-200 bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-500">Theme</th>
          <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-500">Source</th>
          <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-500">Status</th>
          <th class="px-6 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {% for theme in themes %}
          <tr>
            <td class="px-6 py-4">
              <a href="{{ theme.editorHref }}"
                 class="font-semibold text-indigo-600 hover:text-indigo-800">{{ theme.name }}</a>
              <p class="mt-1 text-sm text-gray-500">{{ theme.description }}</p>
            </td>
            <td class="px-6 py-4 text-sm text-gray-600">{{ theme.source }}</td>
            <td class="px-6 py-4">
              <span class="inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700">{{ theme.status }}</span>
            </td>
            <td class="px-6 py-4 text-right">
              <a href="{{ theme.editorHref }}"
                 title="Edit {{ theme.name }}"
                 aria-label="Edit {{ theme.name }}"
                 class="inline-flex h-10 items-center justify-center rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700">
                Edit theme
              </a>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="4" class="px-6 py-10 text-center text-sm text-gray-400">No themes are available.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
