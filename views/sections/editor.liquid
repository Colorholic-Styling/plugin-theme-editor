<div class="px-4 py-5 sm:px-6 sm:py-8 lg:px-8"
     data-theme-editor
     data-editor-action="{{ loadAction }}">
  <div class="flex items-center justify-between gap-4 mb-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">{{ title }}</h1>
      <p class="mt-1 text-sm text-gray-500">{{ description }}</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="{{ dashboardHref }}"
         class="inline-flex h-10 items-center justify-center rounded-lg border border-gray-300 bg-white px-4 text-sm font-semibold text-gray-700 hover:bg-gray-50">
        Themes
      </a>
      {% if nativeEditHref != blank %}
        <a href="{{ nativeEditHref }}"
           class="inline-flex h-10 items-center justify-center rounded-lg border border-gray-300 bg-white px-4 text-sm font-semibold text-gray-700 hover:bg-gray-50">
          Native editor
        </a>
      {% endif %}
    </div>
  </div>

  {% if flash != blank %}
    <p class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{{ flash }}</p>
  {% endif %}

  <form method="get" action="{{ loadAction }}" class="mb-4 flex flex-wrap items-end gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
    <input type="hidden" name="theme" value="{{ themeId }}">
    <label class="min-w-0 flex-1" style="min-width:16rem">
      <span class="mb-1 block text-sm font-medium text-gray-700">CMS page</span>
      <select name="page_id" class="block h-10 w-full rounded-lg border border-gray-300 bg-white px-3 text-sm">
        {% for page in pages %}
          <option value="{{ page.id }}"{% if page.selected %} selected{% endif %}>{{ page.label }}</option>
        {% endfor %}
      </select>
    </label>
    <label style="min-width:12rem">
      <span class="mb-1 block text-sm font-medium text-gray-700">Theme template</span>
      <select name="template" class="block h-10 w-full rounded-lg border border-gray-300 bg-white px-3 text-sm">
        {% for template in templates %}
          <option value="{{ template.id }}"{% if template.selected %} selected{% endif %}>{{ template.label }}</option>
        {% endfor %}
      </select>
    </label>
    <label style="min-width:10rem">
      <span class="mb-1 block text-sm font-medium text-gray-700">Content language</span>
      <select name="language" class="block h-10 w-full rounded-lg border border-gray-300 bg-white px-3 text-sm">
        {% for option in languages %}
          <option value="{{ option.code }}"{% if option.selected %} selected{% endif %}>{{ option.code }}</option>
        {% endfor %}
      </select>
    </label>
    <button class="inline-flex h-10 items-center justify-center rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700" type="submit">
      Load
    </button>
  </form>

  {% if hasPages %}
    <textarea hidden aria-hidden="true" data-theme-editor-state>{{ editorStateJson }}</textarea>
    <div class="flex min-w-0 flex-col gap-4 xl:flex-row">
      <div class="min-w-0 flex-1 rounded-xl border border-gray-200 bg-gray-100 p-2 shadow-sm">
        <div class="mb-2 flex items-center justify-between gap-3 px-2">
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Theme preview</p>
          <p class="truncate text-xs text-gray-500">{{ selectedPage.name }}</p>
        </div>
        <iframe
          data-theme-editor-preview
          title="Theme preview for {{ selectedPage.name }}"
          src="{{ previewHref }}"
          class="block w-full rounded-lg border border-gray-300 bg-white"
          style="height:72vh;min-height:32rem">
        </iframe>
      </div>

      <aside data-theme-editor-inspector
             class="min-w-0 shrink-0 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm xl:sticky xl:top-4 xl:self-start"
             style="width:100%;max-width:26rem">
        <div data-theme-editor-panel-viewport
             style="overflow:hidden;transition:height 200ms ease">
          <div data-theme-editor-panel-track
               style="display:flex;width:200%;align-items:flex-start;transform:translateX(0);transition:transform 220ms ease">
            <section data-theme-editor-list-panel
                     style="width:50%;flex:0 0 50%">
              <div class="border-b border-gray-200 p-4">
                <h2 class="text-lg font-bold text-gray-900" tabindex="-1" data-theme-editor-list-heading>Settings</h2>
                <p class="mt-1 text-sm text-gray-500">Choose the page or one of its blocks to edit its stored lect values.</p>
              </div>

              <nav class="p-3" aria-label="Editable theme sections">
                <a href="{{ pageSettingsHref }}"
                   data-theme-editor-focus
                   data-block=""
                   class="mb-1 block rounded-lg px-3 py-2 text-sm{% if pageSelected %} bg-indigo-50 font-semibold text-indigo-700{% else %} text-gray-700 hover:bg-gray-50{% endif %}"
                   {% if pageSelected %}aria-current="true"{% endif %}>
                  Page values
                </a>
                {% for block in blocks %}
                  <div class="mb-1 flex items-center gap-2">
                    <a href="{{ block.href }}"
                       data-theme-editor-focus
                       data-block="{{ block.index }}"
                       class="min-w-0 flex-1 block rounded-lg px-3 py-2 text-sm{% if block.selected %} bg-indigo-50 font-semibold text-indigo-700{% else %} text-gray-700 hover:bg-gray-50{% endif %}">
                      <span class="block truncate">{{ block.label }}</span>
                      <span class="text-xs text-gray-400">{{ block.type }} · block {{ block.index | plus: 1 }}{% if block.sectionHidden %} · hidden{% endif %}</span>
                    </a>
                    {% if canEdit and block.sectionKey != blank %}
                      <form method="post" action="{{ visibilityAction }}" class="shrink-0">
                        <input type="hidden" name="theme" value="{{ themeId }}">
                        <input type="hidden" name="template" value="{{ templateId }}">
                        <input type="hidden" name="section" value="{{ block.sectionKey }}">
                        <input type="hidden" name="page_id" value="{{ selectedPage.id }}">
                        <input type="hidden" name="language" value="{{ language }}">
                        <input type="hidden" name="hidden" value="{% if block.sectionHidden %}0{% else %}1{% endif %}">
                        <button type="submit"
                                title="{% if block.sectionHidden %}Show{% else %}Hide{% endif %} the {{ block.sectionKey }} section in every page using this template"
                                class="inline-flex h-10 shrink-0 items-center justify-center rounded-lg border border-gray-300 bg-white px-3 text-sm font-semibold text-gray-700 hover:bg-gray-50">{%- if block.sectionHidden -%}Show{%- else -%}Hide{%- endif -%}</button>
                      </form>
                    {% endif %}
                  </div>
                {% endfor %}

                {% if hasLooseSections %}
                  <p class="mt-3 mb-2 px-3 text-xs font-semibold uppercase tracking-wide text-gray-500">
                    Template sections
                  </p>
                  {% for section in looseSections %}
                    <div class="mb-1 flex items-center gap-2">
                      <span class="min-w-0 flex-1 block rounded-lg px-3 py-2 text-sm text-gray-700">
                        <span class="block truncate">{{ section.label }}</span>
                        <span class="text-xs text-gray-400">{{ section.type }}{% if section.hidden %} · hidden{% endif %}</span>
                      </span>
                      {% if canEdit %}
                        <form method="post" action="{{ visibilityAction }}" class="shrink-0">
                          <input type="hidden" name="theme" value="{{ themeId }}">
                          <input type="hidden" name="template" value="{{ templateId }}">
                          <input type="hidden" name="section" value="{{ section.key }}">
                          <input type="hidden" name="page_id" value="{{ selectedPage.id }}">
                          <input type="hidden" name="language" value="{{ language }}">
                          <input type="hidden" name="hidden" value="{% if section.hidden %}0{% else %}1{% endif %}">
                          <button type="submit"
                                  title="{% if section.hidden %}Show{% else %}Hide{% endif %} the {{ section.key }} section in every page using this template"
                                  class="inline-flex h-10 shrink-0 items-center justify-center rounded-lg border border-gray-300 bg-white px-3 text-sm font-semibold text-gray-700 hover:bg-gray-50">{%- if section.hidden -%}Show{%- else -%}Hide{%- endif -%}</button>
                        </form>
                      {% endif %}
                    </div>
                  {% endfor %}
                {% endif %}
              </nav>
            </section>

            <form method="post"
                  action="{{ saveAction }}"
                  data-theme-editor-form
                  data-theme-editor-settings-panel
                  style="width:50%;flex:0 0 50%">
              <input type="hidden" name="theme" value="{{ themeId }}">
              <input type="hidden" name="template" value="{{ templateId }}">
              <input type="hidden" name="page_id" value="{{ selectedPage.id }}">
              <input type="hidden" name="language" value="{{ language }}">
              <input type="hidden" name="block" value="{{ selectedBlock }}" data-theme-editor-selected-block>

              <div class="flex items-center justify-between gap-3 border-b border-gray-200 p-3">
                <div class="min-w-0 flex items-center gap-2 pl-1">
                  <h3 class="truncate text-sm font-bold text-gray-900"
                      data-theme-editor-selected-label
                      aria-live="polite"
                      tabindex="-1">{{ selectedLabel }}</h3>
                  <span class="shrink-0 rounded bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700"
                        data-theme-editor-selected-type
                        {% if selectedType == blank %}hidden{% endif %}>{{ selectedType }}</span>
                </div>
                <button type="button"
                        data-theme-editor-close
                        title="Close settings"
                        aria-label="Close settings"
                        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900">
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 4l12 12M16 4L4 16"></path>
                  </svg>
                </button>
              </div>

              <div class="overflow-y-auto p-4" style="max-height:52vh" data-theme-editor-fields-scroll>
                <div data-theme-editor-fields>
                  {% for group in fieldGroups %}
                    <fieldset class="mb-5 min-w-0">
                      <legend class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">{{ group.label }}</legend>
                      <div class="space-y-3">
                        {% for field in group.fields %}
                          <label class="block min-w-0">
                            <span class="mb-1 flex items-center justify-between gap-2 text-sm font-medium text-gray-700">
                              <span class="truncate">{{ field.label }}</span>
                              <span class="shrink-0 rounded bg-gray-100 px-1.5 py-0.5 text-xs font-medium text-gray-500">{{ field.badge }}</span>
                            </span>
                            {% if field.multiline %}
                              <textarea name="{{ field.inputName }}" rows="4"
                                        class="block min-w-0 w-full max-w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                        {% if field.readOnly or canEdit == false %}readonly{% endif %}>{{ field.value }}</textarea>
                            {% else %}
                              <input name="{{ field.inputName }}" value="{{ field.value }}"
                                     class="block h-10 min-w-0 w-full max-w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                     {% if field.readOnly or canEdit == false %}readonly{% endif %}>
                            {% endif %}
                            <span class="mt-1 block truncate font-mono text-xs text-gray-400">{{ field.path }}</span>
                          </label>
                        {% endfor %}
                      </div>
                    </fieldset>
                  {% endfor %}
                  {% unless hasFields %}
                    <p class="rounded-lg bg-gray-50 px-3 py-4 text-sm text-gray-500">This selection has no scalar values to edit yet.</p>
                  {% endunless %}
                </div>
              </div>

              <div class="border-t border-gray-200 p-4">
                {% if canEdit %}
                  <p data-theme-editor-save-status
                     role="status"
                     aria-live="polite"
                     class="mb-3 rounded-lg px-3 py-2 text-sm"
                     hidden></p>
                  <button type="submit"
                          data-theme-editor-save-button
                          class="inline-flex h-10 w-full items-center justify-center rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700 disabled:cursor-wait disabled:opacity-60">
                    Save changes
                  </button>
                {% else %}
                  <span class="text-sm text-gray-500">Read-only access</span>
                {% endif %}
              </div>
            </form>
          </div>
        </div>
      </aside>
    </div>
  {% else %}
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-6">
      <h2 class="font-semibold text-amber-900">No readable CMS pages</h2>
      <p class="mt-2 text-sm text-amber-700">Approve at least one page type for Theme Editor under Plugins → Page types.</p>
    </div>
  {% endif %}
</div>
<script src="{{ assetHref }}" defer></script>
